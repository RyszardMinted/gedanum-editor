/* Root container */
#root {
    height: 100%; /* Ensure root takes the full screen */
    flex-direction: column;
    width: 100%;
    position: relative;
    display: flex;
}

/* Toolbar */
#toolbar {
    height: 50px;
    background-color: #333;
    color: white;
    display: flex;
    flex-direction: row;
}

/* Main content area (below the toolbar) */
#mainContent {
    flex-grow: 1; /* Fills the remaining space */
    display: flex; /* Horizontal layout for panels and viewport */
    flex-direction: row;
}


.unity-button {
   width: auto; 
}

.unity-button:hover {
    background-color: #666;
}

/* Panels */
#leftPanel, #rightPanel {
    width: 20%;
    background-color: rgba(0,0,0,0.5);
    color: white;
    height: 100%;
    border: 1px solid green;
}

/* Viewport */
#viewport {
    flex-grow: 1; /* Takes the remaining space in the main content */
    background-color: transparent;
}


#newProjectDialog {
    position: absolute;
    display: none;
    left: 0; top: 0; right: 0; bottom: 0;
    
    background-color: rgba(0,0,0,0.2);
    align-items: center; 
    justify-content: center;
}

.button-selected {
    border-color: yellow;
    background-color: #333; /* Slightly darker for emphasis */
}

.texture-button.selected {
    border-color: yellow;
    background-color: #333; /* Slightly darker for emphasis */
}

#newProjectDialog #popup {
    padding: 40;
    min-width: 400px;
}

.texture-button {
    border: 1px solid white;
    margin: 5px;
    height: 100px;
    width: 100px;
    background-color: #222;
    background-size: cover;
    border-radius: 5px;
}

.texture-button:hover {
    border-color: yellow;
    cursor: pointer;
}

.generic-modal {
    display: none;
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0.5);
}

.modal-content {
    background-color: rgb(70, 70, 70);
    padding: 20px;
    border-radius: 5px;
    min-width: 300px;
}

.modal-text {
    white-space: normal;
    margin-bottom: 20px;
}

.modal-buttons {
    flex-direction: row;
    justify-content: flex-end;
}

.modal-button {
    min-width: 80px;
}

.texture-image {
    width: 100%;
    height: 100%;
    -unity-background-scale-mode: scale-to-fit;
    -unity-image-align: center;
    -unity-background-image-tint-color: rgba(255, 255, 255, 1);
    -unity-background-image-tint-color-hover: rgba(255, 255, 255, 1);
    -unity-background-image-tint-color-active: rgba(255, 255, 255, 1);
    -unity-background-image-tint-color-selected: rgba(255, 255, 255, 1);
}

